<!DOCTYPE html>
<html>
<head>
    <title>Add New User</title>
</head>

<body>

    <h2>Add New User</h2>

    <form method="POST" action="/user">

        <input
            type="text"
            name="username"
            placeholder="Enter username"
            required
        >

        <br><br>

        <input
            type="email"
            name="email"
            placeholder="Enter email"
            required
        >

        <br><br>

        <input
            type="password"
            name="password"
            placeholder="Enter password"
            required
        >

        <br><br>

        <button>Add User</button>

    </form>

</body>
</html>